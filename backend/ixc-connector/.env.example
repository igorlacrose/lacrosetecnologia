# Arquivo de exemplo: NÃO COLE credenciais reais aqui nem no GitHub.
IXC_DB_HOST=mysql.interno.exemplo
IXC_DB_PORT=3306
IXC_DB_USER=leitor
IXC_DB_PASSWORD=NAO_ARMAZENAR_NESTE_ARQUIVO
IXC_DB_NAME=banco_autorizado
IXC_DB_TLS_CA_FILE=C:/certificados/mysql-ca.pem
# IXC_DB_HOST deve ser o nome DNS do certificado, resolvido na rede autorizada.
# O driver não suporta IP com nome TLS alternativo; não definir SERVERNAME diferente.
IXC_QUERY_TIMEOUT_MS=10000
IXC_TOTAL_TIMEOUT_MS=90000
# IXC_SCHEMA_OUTPUT=C:/LKZ/privado/descoberta.ixc-schema.json
